DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173

DB_NAME=tracenet_db
DB_USER=tracenet_user
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=3306
PASSWORD_RESET_TIMEOUT=1800
DEFAULT_FROM_EMAIL="TraceNet Security <your-tracenet-email@gmail.com>"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-tracenet-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Production deployment security
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Neon PostgreSQL production connection URL
DATABASE_URL=

# Brevo transactional email API (production)
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=TraceNet Security
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
