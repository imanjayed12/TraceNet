DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:5173

DB_NAME=tracenet_db
DB_USER=tracenet_user
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=3306
PASSWORD_RESET_TIMEOUT=1800
DEFAULT_FROM_EMAIL="TraceNet Security <your-tracenet-email@gmail.com>"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-tracenet-email@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false